{
  "$id": "https://scnehaux.com/codex/gov/guidelines/schemas/pad.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Architecture Document (PAD) Validation Policies",
  "type": "object",
  "config": {
    "target_doc": "GDC-009-pad-guideline.md"
  },
  "allOf": [
    {
      "$ref": "#/definitions/metadata_policies"
    },
    {
      "$ref": "#/definitions/section_policies"
    },
    {
      "$ref": "#/definitions/content_policies"
    }
  ],
  "definitions": {
    "metadata_policies": {
      "title": "Metadata Policies",
      "description": "Policies for the YAML Frontmatter (doc_meta)",
      "required": [
        "doc_meta"
      ],
      "properties": {
        "doc_meta": {
          "title": "Required Fields",
          "type": "object",
          "required": [
            "id",
            "title",
            "governed_by",
            "owner",
            "version",
            "status",
            "classification",
            "realizes_capability",
            "fulfilled_by",
            "review_cycle_days",
            "last_reviewed"
          ],
          "properties": {
            "status": {
              "title": "Allowed Statuses",
              "type": "string",
              "enum": [
                "proposed",
                "approved",
                "deprecated"
              ]
            },
            "classification": {
              "title": "Allowed Classifications",
              "type": "string",
              "enum": [
                "public",
                "internal",
                "restricted"
              ]
            },
            "id": {
              "title": "Document ID",
              "type": "string"
            },
            "title": {
              "title": "Document Title",
              "type": "string"
            },
            "governed_by": {
              "title": "Governed By",
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "owner": {
              "title": "Owner",
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "version": {
              "title": "Version",
              "type": [
                "string",
                "number"
              ]
            },
            "realizes_capability": {
              "title": "Realizes Capability",
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "fulfilled_by": {
              "title": "Fulfilled By",
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "review_cycle_days": {
              "title": "Review Cycle (Days)",
              "type": "integer"
            },
            "last_reviewed": {
              "title": "Last Reviewed Date",
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "section_policies": {
      "title": "Section Policies",
      "description": "Policies for required and recommended sections in the Markdown body",
      "required": [
        "Purpose",
        "Enterprise Position",
        "Scope",
        "Capability Model",
        "Domain Model",
        "Context Model",
        "Trust & Responsibility Model",
        "Integration Contract",
        "NFR",
        "Ownership & Governance",
        "Traceability"
      ],
      "recommended": [
        "Known Constraints",
        "Product Evolution",
        "References"
      ],
      "x-titles": {
        "required": "Required Sections",
        "recommended": "Recommended Sections"
      }
    },
    "content_policies": {
      "title": "Content Quality Policies",
      "description": "Policies for required and recommended keywords inside specific Markdown sections",
      "properties": {
        "Business Capability": {
          "type": "string",
          "allOf": [
            {
              "pattern": "[\\s\\S]*Capability[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Maturity[\\s\\S]*"
            }
          ],
          "x-titles": {
            "required": "Business Capability (Required)"
          }
        },
        "Trust & Data Boundaries": {
          "type": "string",
          "allOf": [
            {
              "pattern": "[\\s\\S]*Trust[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Data[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Compliance[\\s\\S]*"
            }
          ],
          "recommended": [
            "Identity"
          ],
          "x-titles": {
            "required": "Trust & Data Boundaries (Required)",
            "recommended": "Trust & Data Boundaries (Recommended)"
          }
        },
        "Context & Scope": {
          "type": "string",
          "allOf": [
            {
              "pattern": "[\\s\\S]*Purpose[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Goals[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Non-Goal[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Stakeholder[\\s\\S]*"
            }
          ],
          "x-titles": {
            "required": "Context & Scope (Required)"
          }
        },
        "Domain Model": {
          "type": "string",
          "allOf": [
            {
              "pattern": "[\\s\\S]*Bounded Context[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Context Mapping[\\s\\S]*"
            }
          ],
          "recommended": [
            "Domain Event"
          ],
          "x-titles": {
            "required": "Domain Model (Required)",
            "recommended": "Domain Model (Recommended)"
          }
        },
        "Ownership & Governance": {
          "type": "string",
          "allOf": [
            {
              "pattern": "[\\s\\S]*Owner[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*fulfilled_by[\\s\\S]*"
            }
          ],
          "x-titles": {
            "required": "Ownership & Realizing Systems (Required)"
          }
        },
        "Integration Contract": {
          "type": "string",
          "allOf": [
            {
              "pattern": "[\\s\\S]*API[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Consumer[\\s\\S]*"
            },
            {
              "pattern": "[\\s\\S]*Dependencies[\\s\\S]*"
            }
          ],
          "recommended": [
            "Event",
            "Provider",
            "External"
          ],
          "x-titles": {
            "required": "Integration Contracts (Required)",
            "recommended": "Integration Contracts (Recommended)"
          }
        },
        "NFR": {
          "type": "string",
          "recommended": [
            "SLA",
            "SLO",
            "Availability",
            "Scalability",
            "Compliance",
            "Data Privacy",
            "RTO",
            "RPO",
            "Budget"
          ],
          "x-titles": {
            "recommended": "NFR Derivatives (Recommended)"
          }
        }
      }
    }
  }
}