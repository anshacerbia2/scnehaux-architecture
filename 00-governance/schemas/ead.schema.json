{
  "$id": "https://scnehaux.com/codex/gov/guidelines/schemas/ead.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enterprise Architecture Document (EAD) Validation Policies",
  "type": "object",
  "config": {
    "target_doc": "GDC-006-ead-guideline.md"
  },
  "allOf": [
    {
      "$ref": "#/definitions/metadata_policies"
    },
    {
      "$ref": "#/definitions/section_policies"
    },
    {
      "$ref": "#/definitions/content_policies"
    }
  ],
  "definitions": {
    "metadata_policies": {
      "title": "Metadata Policies",
      "description": "Policies for the YAML Frontmatter (doc_meta)",
      "required": ["doc_meta"],
      "properties": {
        "doc_meta": {
          "title": "Required Fields",
          "type": "object",
          "required": [
            "id",
            "title",
            "governed_by",
            "owner",
            "version",
            "status",
            "classification",
            "review_cycle_days",
            "last_reviewed"
          ],
          "properties": {
            "status": {
              "title": "Allowed Statuses",
              "type": "string",
              "enum": ["proposed", "approved", "deprecated"]
            },
            "classification": {
              "title": "Allowed Classifications",
              "type": "string",
              "enum": ["public", "internal", "restricted"]
            },
            "id": {
              "title": "Document ID",
              "type": "string",
              "pattern": "^EAD-\\d{3}$"
            },
            "title": {
              "title": "Document Title",
              "type": "string"
            },
            "governed_by": {
              "title": "Governed By",
              "type": ["string", "array"],
              "items": {
                "type": "string"
              }
            },
            "owner": {
              "title": "Owner",
              "type": ["string", "array"],
              "items": {
                "type": "string"
              }
            },
            "version": {
              "title": "Version",
              "type": ["string", "number"]
            },
            "review_cycle_days": {
              "title": "Review Cycle (Days)",
              "type": "integer"
            },
            "last_reviewed": {
              "title": "Last Reviewed Date",
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "section_policies": {
      "title": "Section Policies",
      "description": "Policies for required and recommended sections in the Markdown body",
      "required": [
        "Purpose",
        "Scope",
        "Enterprise Context",
        "Architectural Drivers & Lessons",
        "Architecture Model",
        "Principles & Rules",
        "Alternatives Considered",
        "Single Points of Failure & Graceful Degradation",
        "Ownership",
        "Dependencies",
        "Traceability"
      ],
      "recommended": [
        "Assumptions",
        "Constraints",
        "Risks",
        "Future Direction",
        "References"
      ],
      "x-titles": {
        "required": "Required Sections",
        "recommended": "Recommended Sections"
      }
    },
    "content_policies": {
      "title": "Content Quality Policies",
      "description": "Policies for required and recommended keywords inside specific Markdown sections",
      "allOf": [
        {
          "if": {
            "properties": {
              "doc_meta": { "properties": { "id": { "const": "EAD-001" } } }
            }
          },
          "then": {
            "properties": {
              "Architecture Model": {
                "allOf": [
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Macro Capability Map" },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Domain Ownership Matrix"
                  },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Strategic Domain Classification"
                  },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Capability Evolution" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "doc_meta": { "properties": { "id": { "const": "EAD-002" } } }
            }
          },
          "then": {
            "properties": {
              "Architecture Model": {
                "allOf": [
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Global System Landscape"
                  },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Platform vs Product Topology"
                  },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?System Dependency" },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?External Ecosystem" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "doc_meta": { "properties": { "id": { "const": "EAD-003" } } }
            }
          },
          "then": {
            "properties": {
              "Architecture Model": {
                "allOf": [
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Data Ownership" },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Transactional & Analytical Boundary"
                  },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Data Movement Strategy"
                  },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Data Governance" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "doc_meta": { "properties": { "id": { "const": "EAD-004" } } }
            }
          },
          "then": {
            "properties": {
              "Architecture Model": {
                "allOf": [
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Enterprise Context Map"
                  },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Communication Strategy"
                  },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Contract Governance" },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Gateway & Broker Topology"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "doc_meta": { "properties": { "id": { "const": "EAD-005" } } }
            }
          },
          "then": {
            "properties": {
              "Architecture Model": {
                "allOf": [
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Platform Topology" },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Internal Developer Platform Strategy"
                  },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Runtime Strategy" },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Operational Model" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "doc_meta": { "properties": { "id": { "const": "EAD-006" } } }
            }
          },
          "then": {
            "properties": {
              "Architecture Model": {
                "allOf": [
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Zero Trust Boundary" },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Enterprise IAM Strategy"
                  },
                  {
                    "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Security Control Architecture"
                  },
                  { "pattern": "###\\s+(?:[\\d\\.]+\\s+)?Data Protection" }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
