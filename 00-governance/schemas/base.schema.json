{
  "$id": "https://scnehaux.com/codex/gov/guidelines/schemas/base.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Base Governance Rules",
  "type": "object",
  "config": {
    "target_doc": "GDC-001-fitness-functions.md"
  },
  "x-global-config": {
    "structure_rules": {
      "artifact_directories": {
        "GDC": "00-governance",
        "EAD": "01-enterprise",
        "STD": "02-standards",
        "PAD": "03-domain",
        "SAD": "04-system",
        "ADR": "05-decisions",
        "TDD": "docs/designs"
      },
      "ignored_files": {
        "exact_matches": [
          "readme.md",
          "index.md",
          "contributing.md",
          "changelog.md",
          "maturity.md",
          "traceability.md",
          "temp.md",
          "scnehaux_enterprise_architecture_refinement.md"
        ],
        "patterns": [
          "\\.copy\\.md$",
          "\\.template\\.md$",
          "-template\\.md$",
          "[\\\\/]templates[\\\\/]",
          "[\\\\/]scratch[\\\\/]"
        ]
      },
      "max_directory_depth": 3
    },
    "content_rules": {
      "exempt_statuses": [
        {
          "status": "draft",
          "depend_on": "created_date",
          "max_age_days": 30,
          "error_message": "Document with status '{doc_status}' has an age of {age_days} days (since {depend_on}), exceeding limit of {limit} days. Must be reviewed, finalized, or deleted."
        },
        {
          "status": "deprecated",
          "depend_on": "last_updated",
          "max_age_days": 180,
          "error_message": "Document with status '{doc_status}' has an age of {age_days} days (since {depend_on}), exceeding limit of {limit} days. Must be fully retired and deleted."
        }
      ],
      "legacy_unauthorized_major_revisions": [
        {
          "debt_id": "GOV-DEBT-001",
          "id": "STD-IAM-001",
          "owner": "Enterprise Security Architect",
          "expires": "2026-12-31",
          "required_action": "Record the ADR that authorizes the active major revision or replace the standard through the governed lifecycle.",
          "reason": "Major version 2 predates the authorized_by field; the Identity Platform owner must record the authorizing ADR."
        },
        {
          "debt_id": "GOV-DEBT-002",
          "id": "STD-GLB-002",
          "owner": "Architecture Review Board",
          "expires": "2026-12-31",
          "required_action": "Record the ADR that authorizes the active major revision or replace the standard through the governed lifecycle.",
          "reason": "Major version 2 (commit 68c128a) predates the authorized_by field; the database standard owner must record the authorizing ADR."
        },
        {
          "debt_id": "GOV-DEBT-003",
          "id": "STD-GLB-004",
          "owner": "Enterprise Architect",
          "expires": "2026-12-31",
          "required_action": "Record the ADR that authorizes the active major revision or replace the standard through the governed lifecycle.",
          "reason": "Major version 3 predates the authorized_by field; the event-driven standard owner must record the authorizing ADR."
        },
        {
          "debt_id": "GOV-DEBT-004",
          "id": "STD-GLB-FE-003",
          "owner": "Enterprise Security Architect",
          "expires": "2026-12-31",
          "required_action": "Record the ADR that authorizes the active major revision or replace the standard through the governed lifecycle.",
          "reason": "Major version 2 (commit 68c128a) predates the authorized_by field; the frontend security owner must record the authorizing ADR."
        },
        {
          "debt_id": "GOV-DEBT-005",
          "id": "STD-GLB-FE-010",
          "owner": "Principal Frontend Architect",
          "expires": "2026-12-31",
          "required_action": "Record the ADR that authorizes the active major revision or replace the standard through the governed lifecycle.",
          "reason": "Major version 2 (commit 68c128a) predates the authorized_by field; the frontend data-access owner must record the authorizing ADR."
        }
      ],
      "max_review_age_days": {
        "value": 365,
        "error_message": "Document review age of {age_days} days exceeds limit of {limit} days."
      },
      "min_content_length_chars": {
        "value": 50,
        "error_message": "Section '{section_name}' content length ({length} chars) is below minimum of {min_length} chars."
      },
      "prohibited_words": {
        "patterns": [
          "\\bmaybe\\b",
          "\\bprobably\\b",
          "\\bshould consider\\b",
          "\\bTBD\\b",
          "\\bcoming soon\\b",
          "\\band so on\\b",
          "\\bseamless(?:ly)?\\b",
          "\\bobviously\\b",
          "\\bblazingly\\b",
          "\\btrivially\\b"
        ],
        "error_message": "Prohibited boilerplate or hesitant word detected. Use definitive, professional language."
      },
      "ambiguity_rules": {
        "patterns": [
          "\\b(highly|very|extremely|super|incredibly)\\s+(scalable|fast|secure|reliable|available|performant|robust|efficient)\\b"
        ],
        "error_message": "Vague claim detected. Must be quantified with metrics."
      }
    },
    "severity_levels": {
      "0. Engine Execution Domain (System Fatality)": {
        "unreadable_artifact": "CRITICAL",
        "corrupt_frontmatter": "CRITICAL",
        "unknown_document_type": "CRITICAL",
        "missing_validator": "CRITICAL",
        "missing_domain_schema": "CRITICAL",
        "invalid_lint_disable": "ERROR"
      },
      "1. Topology & Identity Domain (Graph & Lineage)": {
        "circular_dependency": "CRITICAL",
        "cross_reference_missing": "ERROR",
        "duplicate_id": "CRITICAL",
        "inline_reference_missing": "WARNING",
        "decision_lineage_violation": "ERROR",
        "orphan_document": "ERROR",
        "traceability_violation": "ERROR",
        "broken_internal_link": "ERROR"
      },
      "2. Structural Compliance Domain (Shape & Completeness)": {
        "missing_metadata": "ERROR",
        "missing_required_subsection": "ERROR",
        "missing_section": "ERROR",
        "missing_section_keyword": "ERROR",
        "schema_validation_failed": "CRITICAL",
        "subsection_order_violation": "WARNING"
      },
      "3. Semantic & Quality Domain (Meaning & Language)": {
        "ambiguity_rules": "WARNING",
        "nfr_taxonomy_violation": "ERROR",
        "prohibited_words": "ERROR",
        "structural_integrity_violation": "CRITICAL",
        "stylistic_deviation": "WARNING",
        "vague_claim_in_nfr": "ERROR"
      },
      "4. Lifecycle & Environment Domain (Time, Space, & State)": {
        "approved_version_not_stable": "ERROR",
        "compliance_filename_match": "ERROR",
        "compliance_macro_directory": "ERROR",
        "draft_status_violation": "ERROR",
        "exception_expired": "ERROR",
        "exempt_document_skipped": "INFO",
        "review_age_violation": "WARNING",
        "unauthorized_major_revision": "ERROR",
        "version_bump_required": "ERROR"
      },
      "5. Architecture Constraints Domain (Hard Technical Limits)": {
        "operational_stability_violation": "ERROR",
        "prohibited_technology_violation": "ERROR",
        "security_isolation_violation": "CRITICAL",
        "technology_hold_violation": "CRITICAL",
        "technology_sunset_grace": "WARNING",
        "unapproved_technology": "ERROR"
      }
    },
    "blocking_severities": ["CRITICAL", "ERROR"]
  },
  "definitions": {
    "common_metadata_fields": {
      "title": "Common Metadata Fields",
      "type": "object",
      "required": ["id", "title", "status", "created_date"],
      "properties": {
        "id": { "title": "Document ID", "type": "string" },
        "title": { "title": "Title", "type": "string" },
        "owner": {
          "title": "Owner",
          "type": ["string", "array"],
          "items": { "type": "string" }
        },
        "version": {
          "title": "Version",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-zA-Z0-9-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-zA-Z0-9-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "error_message": "Must follow Semantic Versioning (e.g. 1.0.0)"
        },
        "status": {
          "title": "Allowed Statuses",
          "type": "string"
        },
        "classification": {
          "title": "Allowed Classifications",
          "type": "string",
          "enum": ["public", "internal", "restricted", "confidential"]
        },
        "review_cycle_days": {
          "title": "Review Cycle (Days)",
          "type": "integer"
        },
        "created_date": {
          "title": "Created Date",
          "type": "string",
          "format": "date"
        },
        "last_updated": {
          "title": "Last Updated Date",
          "type": "string",
          "format": "date"
        },
        "last_reviewed": {
          "title": "Last Reviewed Date",
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
